# Network Ports
PORT=27015
STEAM_PORT=26901

# Steam depot manifest id of the game build baked into the image.
# Leave empty to use the image's baked version.
GAME_MANIFEST=

# Server Mode (false = 8 players with mod stack, true = 4 players vanilla)
VANILLA=false

# Server Identity & Configuration
SERVER_NAME=Left 4 Dead 2 Dedicated Server
RCON_PASSWORD=ChangeThisRconPassword123
SERVER_PASSWORD=
DEFAULT_MAP=c1m1_hotel

# Steam Group Settings (optional)
STEAM_GROUP_ID=
STEAM_GROUP_EXCLUSIVE=0

# Server Enforcement (0 = disabled, 1 = enabled)
SV_CONSISTENCY=0
SV_PURE=0

# Extra command line arguments passed to srcds_run
# WARNING: flags that silently break server discovery are rejected at startup
# (-insecure, -nomaster, -lan, sv_lan 1). See the README.
EXTRA_ARGS=
