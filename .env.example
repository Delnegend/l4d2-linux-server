# Network Ports
PORT=27015
STEAM_PORT=26901

# Server Identity & Configuration
SERVER_NAME=Left 4 Dead 2 Dedicated Server
RCON_PASSWORD=ChangeThisRconPassword123
SERVER_PASSWORD=
DEFAULT_MAP=c1m1_hotel
MAX_PLAYERS=8

# Steam Group Settings (optional)
STEAM_GROUP_ID=
STEAM_GROUP_EXCLUSIVE=0

# Server Enforcement (0 = disabled, 1 = enabled)
SV_CONSISTENCY=0
SV_PURE=0

# Updates
# Set AUTO_UPDATE=true to check and apply updates on container startup
AUTO_UPDATE=false
VALIDATE_ON_BOOT=false

# Auto-install SourceMod & MetaMod:Source on first boot
INSTALL_SOURCEMOD=false

# Extra command line arguments passed to srcds_run
EXTRA_ARGS=
