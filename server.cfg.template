// Server Name & Passwords
hostname "${SERVER_NAME}"
rcon_password "${RCON_PASSWORD}"
sv_password "${SERVER_PASSWORD}"

// Server Region & LAN Settings
// 255 = worldwide, 0 = US East, 1 = US West, 2 = South America, 3 = Europe, 4 = Asia, 5 = Australia
sv_region 255
sv_lan 0

// Matchmaking & Visibility
sv_allow_lobby_connect_only 0
sv_steamgroup "${STEAM_GROUP_ID}"
sv_steamgroup_exclusive "${STEAM_GROUP_EXCLUSIVE}"

// Network & Tickrate Performance
//
// sv_minupdaterate / sv_maxupdaterate are deliberately absent: L4D2 has no such
// cvars and the engine logs "Unknown command" for every one of them. The
// tickrate cvars that do exist (fps_max, nb_update_frequency, net_splitrate)
// belong in server_custom.cfg, and only matter once a tickrate is unlocked.
sv_minrate 30000
sv_maxrate 100000
sv_mincmdrate 30
sv_maxcmdrate 100
net_splitpacket_maxrate 50000

// Consistency & Pure Checks
// sv_consistency must stay 0 once a co-op campaign seats more than four
// survivors - the consistency check rejects the extra model files.
sv_consistency ${SV_CONSISTENCY}
sv_pure ${SV_PURE}

// Gameplay / Voice
sv_voiceenable 1
sv_alltalk 0

// Logging
log on
sv_logecho 1
sv_logfile 1
sv_log_onefile 0

// Persistent overrides from cfg/server_custom.cfg are appended to this file
// by the entrypoint, below everything above. They are not `exec`'d from here:
// the engine resolves `exec` against the install root, which lives in the
// image rather than on the volume, so the file on the volume is unreachable
// that way.
